DEFAULT_CLIP_MODEL_ALIAS = "clip"

def load_model(alias_name: str):
    """Loads a model and its corresponding components using the alias."""
    if alias_name not in loaded_models:
        model_info = SUPPORTED_MODELS.get(alias_name)
        if not model_info:
            raise ValueError(f"Model alias '{alias_name}' is not supported.")

        # Get the path where models are stored (usually the home directory)
        # We'll use the current directory as a safe default.
        download_path = os.getcwd()

        # Check for disk space
        _, _, free_space = shutil.disk_usage(download_path)
        if free_space < MIN_DISK_SPACE:
            raise RuntimeError(
                f"Insufficient disk space to download new model '{alias_name}'. "
                f"Available: {free_space / (1024**3):.2f} GB, Required: 1.00 GB."
            )

        full_model_name = model_info["full_name"]
        print(f"Loading model: {full_model_name} (alias: {alias_name})...")

        if model_info["type"] == "clip":
            processor = model_info["processor_class"].from_pretrained(full_model_name)
            model = model_info["model_class"].from_pretrained(full_model_name)
            loaded_models[alias_name] = {"processor": processor, "model": model, "type": "clip"}

        elif model_info["type"] == "sentence_transformer":
            # Simplify loading by using the SentenceTransformer library
            config_kwargs = model_info.get("config_kwargs")
            if config_kwargs:
                model = SentenceTransformer(full_model_name, config_kwargs=config_kwargs)
            else:
                model = SentenceTransformer(full_model_name)
            loaded_models[alias_name] = {"model": model, "type": "sentence_transformer"}

        elif model_info["type"] == "caption":
            processor = model_info["processor_class"].from_pretrained(full_model_name)
            model = model_info["model_class"].from_pretrained(full_model_name)
            loaded_models[alias_name] = {"processor": processor, "model": model, "type": "caption"}

        elif model_info["type"] == "pe":
            model = pe.CLIP.from_config(full_model_name, pretrained=True)
            preprocess = transforms.get_image_transform(model.image_size)
            tokenizer = transforms.get_text_tokenizer(model.context_length)
            loaded_models[alias_name] = {"model": model, "processor": preprocess, "tokenizer": tokenizer, "type": "pe"}

        elif model_info["type"] == "llm":
            # quantization would be for the larger models! (to load them into GPU!)
            # nf4_config = BitsAndBytesConfig(
            #    load_in_4bit=True,
            #    bnb_4bit_quant_type="nf4",
            #    bnb_4bit_use_double_quant=True,
            #    bnb_4bit_compute_dtype=torch.bfloat16
            #)
            model = AutoModelForCausalLM.from_pretrained(
                full_model_name
            #    quantization_config=nf4_config,
            #    torch_dtype=torch.bfloat16
            )
            tokenizer = model_info["tokenizer_class"].from_pretrained(full_model_name)
            loaded_models[alias_name] = {"tokenizer": tokenizer, "model": model, "type": "llm"}
            if "processor_class" in model_info:
                processor = model_info["processor_class"].from_pretrained(full_model_name)
                loaded_models[alias_name]["processor"] = processor

        else:
            raise ValueError(f"Unknown model type for {full_model_name}: {model_info['type']}")
        print(f"Model {full_model_name} loaded.")
    return loaded_models[alias_name]

# Load default CLIP model on startup
with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
    future = executor.submit(load_model, DEFAULT_CLIP_MODEL_ALIAS)
    future.result()

# --- Pydantic Models ---
class ImageRequest(BaseModel):
    image: str
    model: str = Query(DEFAULT_CLIP_MODEL_ALIAS, description="Optional: Specify a model alias for image encoding.")
    max_length: int = 50 # only used for caption endpoint
    dimensions: Optional[int] = Query(None, description="Optional: Truncate embedding to given dimensions.")

class TextRequest(BaseModel):
    text: str
    model: str = Query(DEFAULT_CLIP_MODEL_ALIAS, description="Optional: Specify a text embedding model alias.")
    prompt_name: Optional[str] = Query(None, description="Optional: Specify prompt_name for model encoding (e.g. SearchQuery).")
    dimensions: Optional[int] = Query(None, description="Optional: Truncate embedding to given dimensions.")

class MultiRequest(BaseModel):
    text: Optional[str] = None
    image: Optional[str] = None
    model: str = Query("gemmaemb2", description="Optional: Specify embedding model alias.")
    prompt_name: Optional[str] = Query(None, description="Optional: Specify prompt_name for model encoding (e.g. SearchQuery).")
    dimensions: Optional[int] = Query(None, description="Optional: Truncate embedding to given dimensions.")

# New Pydantic class for LLM requests
class LLMRequest(BaseModel):
    text: str
    image: str = None  # Optional image field
    model: str = Query("gemma270m", description="Optional: Specify a LLM Model.")

# --- API Endpoints ---
@app.post("/image")
async def get_vector_from_image(request: ImageRequest):
    if not request.image:
        raise HTTPException(status_code=400, detail="No image data provided")

    model_alias = request.model
    model_info = SUPPORTED_MODELS.get(model_alias)

    if not model_info or model_info["type"] not in ["clip", "pe", "sentence_transformer"]:
        raise HTTPException(status_code=400, detail=f"Model '{model_alias}' does not support image encoding.")

    try:
        model_components = load_model(model_alias)
        model_type = model_components["type"]

        image_bytes = base64.b64decode(request.image)
        image = Image.open(io.BytesIO(image_bytes)).convert("RGB")

        if model_type == "clip":
            model = model_components["model"]
            processor = model_components["processor"]
            inputs = processor(images=image, return_tensors="pt")
            with torch.no_grad():
                image_features = model.get_image_features(**inputs)
            res = image_features.squeeze().tolist()
            if request.dimensions:
                res = res[:request.dimensions]
            return res

        elif model_type == "pe":
            model = model_components["model"]
            processor = model_components["processor"]
            image_tensor = processor(image).unsqueeze(0)
            with torch.no_grad():
                image_features = model.encode_image(image_tensor)
            res = image_features.squeeze().tolist()
            if request.dimensions:
                res = res[:request.dimensions]
            return res

        elif model_type == "sentence_transformer":
            model = model_components["model"]
            encode_kwargs = {"normalize_embeddings": True}
            if request.dimensions:
                encode_kwargs["truncate_dim"] = request.dimensions
            embedding = model.encode({"image": image}, **encode_kwargs)
            return embedding.tolist()
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error processing image: {str(e)}")


@app.post("/text")
async def get_vector_from_text(request: TextRequest):
    if not request.text:
        raise HTTPException(status_code=400, detail="No text provided")

    model_alias = request.model
    model_info = SUPPORTED_MODELS.get(model_alias)

    if not model_info:
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' is not supported.")

    try:
        model_components = load_model(model_alias)
        model_type = model_components["type"]

        if model_type == "clip":
            processor = model_components["processor"]
            model = model_components["model"]
            inputs = processor(text=[request.text], return_tensors="pt")
            with torch.no_grad():
                text_features = model.get_text_features(**inputs)
            res = text_features.squeeze().tolist()
            if request.dimensions:
                res = res[:request.dimensions]
            return res

        elif model_type == "pe":
            tokenizer = model_components["tokenizer"]
            model = model_components["model"]
            text_tokens = tokenizer([request.text])
            with torch.no_grad():
                text_features = model.encode_text(text_tokens)
            res = text_features.squeeze().tolist()
            if request.dimensions:
                res = res[:request.dimensions]
            return res

        elif model_type == "sentence_transformer":
            model = model_components["model"]
            encode_kwargs = {"normalize_embeddings": True}
            if request.dimensions:
                encode_kwargs["truncate_dim"] = request.dimensions
            if request.prompt_name:
                encode_kwargs["prompt_name"] = request.prompt_name
            embedding = model.encode(request.text, **encode_kwargs)
            return embedding.tolist()

        else:
            raise HTTPException(status_code=500, detail=f"Unhandled model type: {model_type} for alias {model_alias}")

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error processing text: {str(e)}")


@app.post("/multi")
async def get_vector_multimodal(request: MultiRequest):
    if not request.text and not request.image:
        raise HTTPException(status_code=400, detail="Please provide text or image data (or both).")

    model_alias = request.model
    model_info = SUPPORTED_MODELS.get(model_alias)

    if not model_info:
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' is not supported.")

    try:
        model_components = load_model(model_alias)
        model_type = model_components["type"]

        image_obj = None
        if request.image:
            image_bytes = base64.b64decode(request.image)
            image_obj = Image.open(io.BytesIO(image_bytes)).convert("RGB")

        if model_type == "sentence_transformer":
            model = model_components["model"]
            encode_kwargs = {"normalize_embeddings": True}
            if request.dimensions:
                encode_kwargs["truncate_dim"] = request.dimensions
            if request.prompt_name:
                encode_kwargs["prompt_name"] = request.prompt_name

            if request.text and image_obj:
                text_str = request.text
                if "<|image|>" not in text_str:
                    text_str = f"{text_str} <|image|>"
                payload = {"text": text_str, "image": image_obj}
            elif request.text:
                payload = request.text
            else:
                payload = {"image": image_obj}

            embedding = model.encode(payload, **encode_kwargs)
            return embedding.tolist()

        elif model_type in ["clip", "pe"]:
            if request.text and not request.image:
                return await get_vector_from_text(TextRequest(text=request.text, model=model_alias, dimensions=request.dimensions))
            elif request.image and not request.text:
                return await get_vector_from_image(ImageRequest(image=request.image, model=model_alias, dimensions=request.dimensions))
            else:
                raise HTTPException(status_code=400, detail=f"Model '{model_alias}' does not support interleaved text and image in a single embedding request.")
        else:
            raise HTTPException(status_code=400, detail=f"Model '{model_alias}' does not support multimodal embeddings.")

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error processing multimodal request: {str(e)}")


@app.post("/caption")
async def generate_caption(request: ImageRequest, model_alias: str = "git"):
    if not request.image:
        raise HTTPException(status_code=400, detail="No image data provided")

    model_info = SUPPORTED_MODELS.get(model_alias)
    if not model_info or model_info["type"] != "caption":
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' is not a supported captioning model.")

    try:
        caption_components = load_model(model_alias)
        processor = caption_components["processor"]
        model = caption_components["model"]

        image_bytes = base64.b64decode(request.image)
        image = Image.open(io.BytesIO(image_bytes))

        inputs = processor(images=image, return_tensors="pt")
        with torch.no_grad():
            generated_ids = model.generate(
		pixel_values=inputs.pixel_values,
		max_length=request.max_length  # <-- Use the value from the request
            )

        generated_caption = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
        return generated_caption
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error generating caption: {str(e)}")


@app.post("/generate")
async def generate_llm_response(request: LLMRequest):
    if not request.text:
        raise HTTPException(status_code=400, detail="No text prompt provided.")

    model_alias = request.model
    model_info = SUPPORTED_MODELS.get(model_alias)

    if not model_info or model_info["type"] != "llm":
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' is not supported.")

    try:
        full_prompt = request.text
        if request.image:
            # Decode the image and generate a caption
            image_bytes = base64.b64decode(request.image)
            image = Image.open(io.BytesIO(image_bytes))

            caption_components = load_model("git")
            processor = caption_components["processor"]
            model = caption_components["model"]

            # Use the existing smallcap model to describe the image
            inputs = processor(images=image, return_tensors="pt")
            with torch.no_grad():
                generated_ids = model.generate(pixel_values=inputs.pixel_values, max_length=50)
            image_caption = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

            # Combine the image caption with the user's text prompt
            full_prompt = f"The image shows: {image_caption}. Based on the image, {request.text}"

        # Format the prompt for the Gemma model
        chat_prompt = f"<start_of_turn>user\n{full_prompt}<end_of_turn>\n<start_of_turn>model"

        llm_components = load_model(model_alias)
        tokenizer = llm_components["tokenizer"]
        model = llm_components["model"]

        # Tokenize the prompt
        inputs = tokenizer(chat_prompt, return_tensors="pt")

        # Store the number of tokens in the input prompt
        input_length = inputs.input_ids.shape[1]

        # Generate the response
        with torch.no_grad():
            outputs = model.generate(**inputs, max_new_tokens=1000, do_sample=True)

        # Slice the tensor to get only the newly generated tokens
        # The full output tensor starts with the input tokens, so we slice from
        # input_length to the end of the tensor
        generated_tokens = outputs[0, input_length:]

        # Decode only the generated tokens
        response = tokenizer.decode(generated_tokens, skip_special_tokens=True)

        return {"response": response}

    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Error generating LLM response: {str(e)}")


@app.post("/multimodal-generate")
async def multimodal_generate(request: LLMRequest):
    if not request.text and not request.image:
        raise HTTPException(status_code=400, detail="Please provide a text prompt or an image.")

    model_alias = request.model
    model_info = SUPPORTED_MODELS.get(model_alias)

    if not model_info or model_info["type"] != "llm":
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' is not supported.")

    if "processor_class" not in model_info and request.image:
        raise HTTPException(status_code=400, detail=f"Model alias '{model_alias}' does not support image inout, use /generate enpoint - which uses a caption model to read the image")

    try:
        llm_components = load_model(model_alias)
        if "processor" not in llm_components:
            processor = llm_components["tokenizer"] #the gemma270m model, only loads a tokenizer, which is ok if dont need image input
        else:
            processor = llm_components["processor"]
        model = llm_components["model"]

        if request.image:
            image_bytes = base64.b64decode(request.image)
            image = Image.open(io.BytesIO(image_bytes))

            # The processor handles image resizing and token encoding
            inputs = processor(text=request.text, images=image, return_tensors="pt")
        else:
            inputs = processor(text=request.text, return_tensors="pt")

        # Move inputs to the same device as the model
        inputs = {k: v.to(model.device) for k, v in inputs.items()}

        # Generate the response
        with torch.no_grad():
            generated_ids = model.generate(**inputs, max_new_tokens=1000, do_sample=True)

        # Decode the output
        generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

        # Return only the model's response
        # The prompt is included in the output, so we split it off
        response = generated_text.split(request.text)[-1].strip()

        return {"response": response}
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error generating response: {str(e)}")


